# Required. Public owner address used to discover Safe accounts.
OWNER_ADDRESS=0xYOUR_OWNER_ADDRESS

# Optional comma-separated chain names. Leave empty to scan every chain.
CHAIN_FILTER=ethereum,gnosis

# Optional comma-separated Safe addresses to inspect in addition to discovery.
EXTRA_SAFE_ADDRESSES=

# Optional RPC URLs enable bytecode and proxy classification.
ETHEREUM_RPC_URL=
GNOSIS_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
AVALANCHE_RPC_URL=
BSC_RPC_URL=
LINEA_RPC_URL=
SCROLL_RPC_URL=
ZKSYNC_RPC_URL=

REPORT_DIR=reports
