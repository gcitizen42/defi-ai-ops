{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dao-treehouse.local/schemas/project-manifest.schema.json",
  "title": "DAO Treehouse project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "sources",
    "networks",
    "nodes",
    "edges",
    "findings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/network"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "confidence": {
      "enum": [
        "verified",
        "corroborated",
        "reported",
        "inferred",
        "conflict",
        "unresolved"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repository"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "defaultBranch",
            "revision"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "defaultBranch": {
              "type": "string"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "uri",
        "observedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "github-repository",
            "repository-file",
            "local-registry",
            "rpc",
            "explorer",
            "sourcify",
            "manual"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "name",
        "observedAtBlock"
      ],
      "properties": {
        "chainId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "observedAtBlock": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "method"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "observedAtBlock": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "project",
            "contract",
            "proxy",
            "implementation",
            "proxy-admin",
            "safe",
            "timelock",
            "governor",
            "role",
            "module",
            "eoa",
            "unknown"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "chainId": {
          "type": "integer",
          "minimum": 1
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "relationship",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relationship": {
          "enum": [
            "OWNS",
            "PENDING_OWNER_OF",
            "GOVERNS",
            "ADMINISTERS",
            "UPGRADES",
            "IMPLEMENTS",
            "BEACON_FOR",
            "PROPOSES_TO",
            "EXECUTES_FOR",
            "CANCELS_FOR",
            "SIGNER_OF",
            "MODULE_OF",
            "GUARDS",
            "FALLBACK_HANDLER_OF",
            "HAS_ROLE_ON",
            "DEPENDS_ON"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "status",
        "title",
        "summary",
        "relatedNodeIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "enum": [
            "open",
            "acknowledged",
            "resolved"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "relatedNodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
